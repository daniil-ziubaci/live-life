---
import InvalidRecord from "@/components/panel/InvalidRecord.astro";
import NeedsNav from "@/components/panel/NeedsNav.astro";
import PanelLayout from "@/layouts/PanelLayout.astro";
import type { Flash } from "@/lib/flash";
import { fieldClass, labelClass, primaryButtonClass } from "@/lib/formClasses";
import { formatRemaining } from "@/lib/formatRemaining";
import { isVolunteer, NOT_A_VOLUNTEER } from "@/lib/panel";

interface Props {
  kind: "open" | "stock" | "closed";
  heading: string;
  emptyText: string;
  archived?: boolean;
  flash: Flash | null;
}

const { kind, heading, emptyText, archived = false, flash } = Astro.props;
const supabase = Astro.locals.supabase;
const volunteer = await isVolunteer(supabase, Astro.locals.claims?.sub);
const { data, error } = volunteer
  ? await supabase
      .from("purchase_items")
      .select("id, name, unit, remaining, is_urgent")
      .eq("is_archived", archived)
      .order("is_urgent", { ascending: false })
      .order("created_at", { ascending: false })
      .order("id")
  : { data: [], error: null };
const filters = {
  open: (remaining: number) => remaining > 0,
  stock: (remaining: number) => remaining < 0,
  closed: (remaining: number) => remaining === 0,
};
const items = (data ?? []).filter((item) => filters[kind](item.remaining));
const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const selected = kind === "open" ? items.find((item) => item.name === query) : undefined;
const here = Astro.url.pathname + Astro.url.search;
---

<PanelLayout title={heading}>
  <main class="mx-auto flex w-full max-w-5xl flex-col gap-4 px-4 pt-4 pb-6">
    <h1 class="text-3xl font-bold sm:text-center">{heading}</h1>
    <InvalidRecord flash={flash} />
    {!volunteer ? (
      <p>{NOT_A_VOLUNTEER}</p>
    ) : (
      <>
        <NeedsNav />
        {error ? (
          <p role="alert">Не удалось загрузить план закупок.</p>
        ) : items.length === 0 ? (
          <p class="text-(--muted)">{emptyText}</p>
        ) : (
          <div
            class:list={[
              kind === "open" &&
                "flex flex-col gap-4 rounded-2xl border border-(--border-strong) bg-(--surface) p-4 shadow-md sm:mx-auto sm:w-half-gap sm:p-6",
            ]}
          >
            {kind === "open" && (
              <form method="get" action={Astro.url.pathname} class="flex flex-col gap-1">
                <label for="item" class={labelClass}>
                  Позиция
                </label>
                <input
                  id="item"
                  name="q"
                  type="text"
                  list="need-names"
                  autocomplete="off"
                  placeholder="Начните вводить название"
                  value={query}
                  class={fieldClass}
                />
                <datalist id="need-names">
                  {items.map((item) => (
                    <option value={item.name} />
                  ))}
                </datalist>
                <p role="status" data-need-hint class="text-(--muted) empty:hidden">
                  {query && !selected ? "Такой позиции нет в списке." : ""}
                </p>
                <noscript>
                  <button type="submit" class={primaryButtonClass}>
                    Показать
                  </button>
                </noscript>
              </form>
            )}
            <ul class:list={[kind === "open" ? "flex flex-col" : "grid grid-cols-1 gap-3 sm:grid-cols-2"]}>
              {items.map((item) => {
                const urgent = kind === "open" && item.is_urgent;
                const result = flash?.key === `consume-${item.id}` ? flash : null;
                const back = kind === "open" ? `${Astro.url.pathname}?q=${encodeURIComponent(item.name)}` : here;
                const editHref = `/volunteer/needs/${item.id}/edit?from=${kind}${kind === "open" ? `&q=${encodeURIComponent(item.name)}` : ""}`;
                const consumeForm = (
                  <form
                    method="post"
                    action={Astro.url.pathname}
                    class:list={["flex flex-col gap-2", kind !== "open" && "p-3 pt-1"]}
                  >
                    <input type="hidden" name="intent" value="consume" />
                    <input type="hidden" name="itemId" value={item.id} />
                    <input type="hidden" name="back" value={back} />
                    <label for={`consumption-${item.id}`} class="font-medium">
                      {kind === "closed" ? "Закончилось? Сколько нужно снова:" : "Сколько израсходовали:"}
                    </label>
                    <input
                      id={`consumption-${item.id}`}
                      name="amount"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      value={result && !result.ok ? result.value : undefined}
                      required
                      class={
                        kind === "open"
                          ? fieldClass
                          : "h-10 w-full rounded-lg border border-(--border-strong) bg-(--surface) px-3 text-base"
                      }
                    />
                    {result && !result.ok && (
                      <p role="alert" class="font-medium text-(--danger)">
                        {result.message}
                      </p>
                    )}
                    <button
                      type="submit"
                      aria-label={`Записать расход: ${item.name}`}
                      data-pending="Записываем…"
                      class="h-10 w-full cursor-pointer rounded-lg bg-(--accent) px-6 font-semibold text-white disabled:cursor-wait disabled:opacity-60"
                    >
                      Записать
                    </button>
                    <p role="status" class="font-medium empty:hidden">
                      {result?.ok ? result.message : ""}
                    </p>
                  </form>
                );
                return (
                  <li
                    class:list={[
                      kind === "open"
                        ? "space-y-3"
                        : "flex flex-col gap-3 rounded-2xl border border-(--border-strong) bg-(--surface) p-3 shadow-md",
                    ]}
                    hidden={kind === "open" && item.id !== selected?.id}
                    data-need-panel={item.id}
                    data-need-name={item.name}
                  >
                    <div class="flex flex-col">
                      {kind !== "open" && <span class="text-lg font-bold wrap-break-word">{item.name}</span>}
                      <span class:list={[kind === "open" ? "text-xl font-bold" : "text-(--muted)"]}>
                        {formatRemaining(item.remaining, item.unit)}
                      </span>
                      {urgent && (
                        <span class="mt-2 self-start rounded-full bg-(--danger-soft) px-2 py-0.5 text-sm font-semibold text-(--danger)">
                          <span aria-hidden="true">🔥 </span>
                          Срочно
                        </span>
                      )}
                    </div>
                    <div class="mt-auto flex flex-col gap-2">
                      {kind === "open" ? (
                        <section class="flex flex-col gap-2">
                          <h2 class="text-lg font-bold">Расход</h2>
                          {consumeForm}
                        </section>
                      ) : (
                        <details
                          class="group rounded-lg border border-(--accent) bg-(--accent-soft)"
                          open={Boolean(result)}
                        >
                          <summary
                            aria-label={`Расход: ${item.name}`}
                            class="flex h-10 cursor-pointer items-center justify-between px-3 font-medium"
                          >
                            Расход
                            <span aria-hidden="true" class="text-(--muted) transition-transform group-open:rotate-180">
                              ▾
                            </span>
                          </summary>
                          {consumeForm}
                        </details>
                      )}
                      <a
                        href={editHref}
                        aria-label={`Редактировать: ${item.name}`}
                        class="flex h-10 w-full items-center justify-center rounded-lg border border-(--border-strong) bg-(--surface) px-3 text-control font-medium"
                      >
                        Редактировать
                      </a>
                      {kind === "closed" && (
                        <form method="post" action={Astro.url.pathname}>
                          <input type="hidden" name="intent" value="archive" />
                          <input type="hidden" name="itemId" value={item.id} />
                          <input type="hidden" name="archived" value={archived ? "0" : "1"} />
                          <input type="hidden" name="back" value={back} />
                          <button
                            type="submit"
                            aria-label={`${archived ? "Вернуть в список" : "Убрать из списка"}: ${item.name}`}
                            class="h-10 w-full cursor-pointer rounded-lg px-3 text-control font-medium text-(--muted) underline"
                          >
                            {archived ? "Вернуть в список" : "Убрать из списка"}
                          </button>
                        </form>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
        {kind === "closed" && (
          <a
            href={archived ? "/volunteer/needs/closed" : "/volunteer/needs/closed?archived=1"}
            class="flex h-10 items-center justify-center text-(--muted) underline sm:self-center"
          >
            {archived ? "К закрытым" : "Показать убранные"}
          </a>
        )}
      </>
    )}
  </main>
</PanelLayout>

<script>
  const picker = document.getElementById("item");
  const hint = document.querySelector("[data-need-hint]");
  if (picker instanceof HTMLInputElement) {
    const panels = () => document.querySelectorAll<HTMLElement>("[data-need-panel]");
    picker.addEventListener("input", () => {
      const text = picker.value.trim();
      for (const panel of panels()) panel.hidden = panel.dataset.needName !== text;
    });
    picker.addEventListener("change", () => {
      const text = picker.value.trim();
      const found = [...panels()].some((panel) => panel.dataset.needName === text);
      if (hint) hint.textContent = text && !found ? "Такой позиции нет в списке." : "";
    });
  }
</script>
