---
import type { ContentLanguage } from "@/lib/contentLanguage";
import { parseDescription } from "@/lib/parseDescription";

interface Props {
  text: string;
  language: ContentLanguage;
}

const { text, language } = Astro.props;
const blocks = parseDescription(text);
const leadsToList = (index: number, lines: string[]) =>
  blocks[index + 1]?.type === "list" && (lines.at(-1) ?? "").trimEnd().endsWith(":");
---

<div lang={language} class="flex flex-col gap-3">
  {blocks.map((block, index) =>
    block.type === "list" ? (
      <ul class="list-disc pl-6">
        {block.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : (
      <p class:list={["whitespace-pre-line", leadsToList(index, block.lines) && "font-bold"]}>
        {block.lines.join("\n")}
      </p>
    ),
  )}
</div>
