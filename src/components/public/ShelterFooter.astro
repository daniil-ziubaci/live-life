---
import SocialLinks from "@/components/public/SocialLinks.astro";
import { getTranslator, type Locale } from "@/lib/i18n";
import type { Shelter } from "@/lib/shelter";

interface Props {
  locale: Locale;
  shelter: Shelter;
}

const { locale, shelter } = Astro.props;
const t = getTranslator(locale, "Footer");
const tNav = getTranslator(locale, "Nav");
const tAbout = getTranslator(locale, "About");
const base = `/${locale}`;
const links = [
  { href: base, label: tNav("home") },
  { href: `${base}/catalog`, label: tNav("catalog") },
  { href: `${base}/needs`, label: tNav("needs") },
  { href: `${base}/catalog?mode=treatment`, label: tNav("treatment") },
  { href: `${base}/projects`, label: tNav("projects") },
  { href: `${base}/about`, label: tNav("about") },
  { href: `${base}/privacy`, label: t("privacyLink") },
];
const phone = shelter.contact_phone;
const email = shelter.contact_email;
const messenger = shelter.contact_messenger;
const [emailBefore = "", emailAfter = ""] = email ? tAbout("emailLine", { email }).split(email) : [];
const hoursLanguage = shelter.translated.hours ? locale : shelter.content_language;
const legalLanguage = shelter.translated.legalInfo ? locale : shelter.content_language;
---

<footer class="mt-auto w-full bg-(--surface)">
  <div class="mx-auto grid w-full max-w-5xl gap-8 px-4 pt-8 pb-6 md:grid-cols-3 md:pb-8 md:gap-x-12">
    <section
      aria-labelledby="footer-contact-heading"
      class="flex flex-col gap-5 max-md:rounded-2xl max-md:bg-(--accent-soft) max-md:p-5"
    >
      <div class="flex flex-col gap-2">
        <h2 id="footer-contact-heading" class="text-xl font-bold">
          {t("contactHeading")}
        </h2>
      </div>
      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-3">
          {phone && (
            <a
              href={`tel:${phone.replace(/[^\d+]/g, "")}`}
              class="flex min-h-14 w-fit max-w-full items-center justify-start rounded-full bg-(--accent) px-6 py-3 text-left text-lg font-semibold text-(--accent-contrast) hover:shadow-md"
            >
              {tAbout("call", { phone })}
            </a>
          )}
          {messenger && (
            <a
              href={messenger}
              class="flex min-h-14 w-fit max-w-full items-center justify-start rounded-full bg-(--accent) px-6 py-3 text-left text-lg font-semibold text-(--accent-contrast) hover:shadow-md"
              target="_blank"
              rel="noopener noreferrer"
            >
              {tAbout("messenger")}
              <span class="sr-only"> {tAbout("newTab")}</span>
            </a>
          )}
          {!phone && !email && !messenger && <p>{t("noContact")}</p>}
        </div>
        {phone && <p class="text-(--muted)">{tAbout("phoneNote")}</p>}
        {email && (
          <p>
            {emailBefore}
            <a
              href={`mailto:${email}`}
              class="block font-semibold break-all text-(--accent) underline underline-offset-2"
            >
              {email}
            </a>
            {emailAfter}
          </p>
        )}
      </div>
      <SocialLinks
        locale={locale}
        instagram={shelter.instagram_url}
        facebook={shelter.facebook_url}
        tiktok={shelter.tiktok_url}
        viber={shelter.viber_url}
        telegram={shelter.telegram_url}
      />
    </section>
    <section
      aria-labelledby="footer-about-heading"
      class="flex flex-col gap-4 max-md:rounded-2xl max-md:bg-(--accent-soft) max-md:p-5"
    >
      <h2 id="footer-about-heading" class="text-xl font-bold">
        {shelter.name}
      </h2>
      <dl class="flex flex-col gap-5 text-pretty">
        {shelter.city && (
          <div>
            <dt class="text-sm text-(--muted)">{t("cityLabel")}</dt>
            <dd class="mt-1">{shelter.city}</dd>
          </div>
        )}
        <div>
          <dt class="text-sm text-(--muted)">{t("addressLabel")}</dt>
          <dd class="mt-1">{shelter.address || t("addressByAppointment")}</dd>
        </div>
        {shelter.contact_hours && (
          <div>
            <dt class="text-sm text-(--muted)">{t("hoursLabel")}</dt>
            <dd class="mt-1" lang={hoursLanguage}>
              {shelter.contact_hours}
            </dd>
          </div>
        )}
        {shelter.founded_year !== null && (
          <div>
            <dt class="text-sm text-(--muted)">{t("foundedLabel")}</dt>
            <dd class="mt-1">{shelter.founded_year}</dd>
          </div>
        )}
        {shelter.legal_info && (
          <div>
            <dt class="text-sm text-(--muted)">{t("legalLabel")}</dt>
            <dd class="mt-1" lang={legalLanguage}>
              {shelter.legal_info}
            </dd>
          </div>
        )}
      </dl>
    </section>
    <nav
      aria-labelledby="footer-links-heading"
      class="flex flex-col gap-3 max-md:rounded-2xl max-md:bg-(--accent-soft) max-md:p-5"
    >
      <p id="footer-links-heading" class="text-xl font-bold">
        {t("linksLabel")}
      </p>
      <ul class="grid grid-cols-2 gap-x-4 md:flex md:flex-col">
        {links.map((link) => (
          <li>
            <a href={link.href} class="inline-block py-3 font-semibold text-(--accent) hover:underline">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  {locale !== shelter.content_language && (
    <p class="mx-auto w-full max-w-5xl px-4 pb-8 text-sm text-(--muted)">{t("translationNote")}</p>
  )}
  <svg aria-hidden="true" focusable="false" class="block h-2.5 w-full text-(--border)">
    <defs>
      <pattern id="footer-wave" width="36" height="10" patternUnits="userSpaceOnUse">
        <path d="M0 5 Q9 0 18 5 T36 5" fill="none" stroke="currentColor" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="100%" height="10" fill="url(#footer-wave)" />
  </svg>
  <div>
    <p class="mx-auto w-full max-w-5xl px-4 py-4 text-sm text-(--muted)">
      © {shelter.founded_year ?? new Date().getFullYear()} {shelter.name}
    </p>
  </div>
</footer>
